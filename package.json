{
  "name": "@cycjimmy/h5-video-player",
  "type": "module",
  "version": "4.0.0",
  "description": "Browser full screen H5 video player",
  "browser": "dist/h5-video-player.umd.min.js",
  "author": "cycjimmy <cycjimmy@gmail.com> (https://github.com/cycjimmy)",
  "license": "MIT",
  "homepage": "https://github.com/cycjimmy/h5-video-player#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cycjimmy/h5-video-player.git"
  },
  "bugs": {
    "url": "https://github.com/cycjimmy/h5-video-player/issues"
  },
  "keywords": [
    "h5",
    "video"
  ],
  "exports": {
    "import": "./dist/h5-video-player.esm.js",
    "default": "./dist/h5-video-player.esm.js"
  },
  "main": "dist/h5-video-player.esm.js",
  "module": "dist/h5-video-player.esm.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.{css,scss}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --color --forceExit --detectOpenHandles",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --color --forceExit --detectOpenHandles --coverage",
    "build": "trash dist && npm run build:esm && npm run build:umd && npm run build:umd:min",
    "build:esm": "vite build --mode esm",
    "build:umd": "vite build --mode umd",
    "build:umd:min": "vite build --mode umd-min",
    "build:deployment": "vite build --mode deployment && node tasks/copyPublishFiles.js",
    "package": "trash .release && npm run build && node tasks/copyFiles.js && node tasks/handlePackageJson.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cycjimmy/awesome-js-funcs": "^5.0.0",
    "@cycjimmy/sass-lib": "^5.0.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@babel/core": "^7.24.9",
    "@babel/preset-env": "^7.24.8",
    "@cycjimmy/config-lib": "^3.2.2",
    "autoprefixer": "^10.4.19",
    "babel-jest": "^30.1.2",
    "cross-env": "^10.0.0",
    "eslint": "^10.14.0",
    "fs-extra": "^11.4.1",
    "globals": "^17.14.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "sass": "^1.108.0",
    "stylelint": "^18.0.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "terser": "^5.51.2",
    "trash-cli": "^7.2.0",
    "vite": "^8.3.6"
  }
}
